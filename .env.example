# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_COOKIE_DOMAIN: only used when NODE_ENV=production. Set to ".cafenoir.tn" (leading dot)
# to share the session cookie across subdomains — needed so docs.cafenoir.tn's nginx auth_request
# gate can read the same session as cafe.cafenoir.tn (see PLAN_SITE_DOCUMENTATION_PRIVE.md). Leave
# unset for a deploy that doesn't need cross-subdomain SSO — the cookie then defaults to the exact
# host that set it, which is also what local development uses regardless of this variable.
# SESSION_COOKIE_DOMAIN=".cafenoir.tn"
