# Base URL of the Café Noir management API the menu is read from (no trailing slash).
# Optional: a production build already defaults to https://system.cafenoir.tn.
# VITE_API_BASE_URL=https://system.cafenoir.tn

# Dev only: where the Vite dev server proxies /api to (the local management server).
# SHOWCASE_DEV_API_TARGET=http://localhost:4000
