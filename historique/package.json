{
  "name": "cafe-noir-historique",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3100 --host=0.0.0.0",
    "dev:full": "concurrently -k -n WEB,API -c cyan,green \"npm:dev\" \"npm:server:dev\"",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && vite build",
    "preview": "vite preview --port=3100 --host=0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "tsx --test server/tests/*.test.ts",
    "seed:demo": "tsx server/scripts/seed-demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
