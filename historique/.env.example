# Port of the Historique API + built SPA. Dev default 4100 (vite on 3100 proxies /api here);
# production uses 3012 (pm2 app "historique", reached directly by the Cloudflare tunnel).
PORT=4100

# Optional: where this app's OWN database lives (defaults to server/data/historique.sqlite3).
# Accounts, sessions, caisses and avances are all stored there — no link to the main app.
# HISTORIQUE_DB_PATH=/var/lib/cafenoir/historique.sqlite3

# NODE_ENV=production turns on secure cookies.
# NODE_ENV=production
