# Port of the Historique API + built SPA. Dev default 4100 (vite on 3100 proxies /api here);
# production uses 3012 (see deploy/historique.cafenoir.tn.nginx.conf).
PORT=4100

# The main management app (system.cafenoir.tn) — the ONLY thing Historique borrows from it is
# authentication: logins, passwords and the historique:* permissions are managed there. Reached
# over the loopback in production (both apps run on the same VM).
MAIN_APP_URL=http://127.0.0.1:4000

# Name of the main app's session cookie (server/middleware/auth.ts SESSION_COOKIE in the main app).
MAIN_SESSION_COOKIE=session

# Optional: where this app's OWN database lives (defaults to server/data/historique.sqlite3).
# HISTORIQUE_DB_PATH=/var/lib/cafenoir/historique.sqlite3

# NODE_ENV=production turns on secure cookies.
# NODE_ENV=production
